{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "MusicService": "http://localhost:5002"
  },
  "Game": {
    "JoinTimeoutSeconds": 15,
    "ReadyTimeoutSeconds": 10,
    "StartDelayMs": 3000,
    "PrefetchWindow": 5
  },
  "Jwt": {
    "Issuer": "slopster-userservice",
    "Audience": "slopster"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "game-events",
    "RoutingKey": "game.finished.v1"
  }
}
